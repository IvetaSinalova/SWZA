---
import '../styles/global.css';
const { title, description } = Astro.props;
const assetPath = (path) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" type="image/png" href={assetPath('/favicon.png')}/><title>{title}</title></head><body><slot/></body></html>
